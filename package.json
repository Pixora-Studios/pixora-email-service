{
  "name": "pixora-email-service",
  "version": "1.0.0",
  "description": "Universal Multi-Provider Email Microservice and Management Dashboard for Pixora Studios",
  "main": "server/dist/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --project server/tsconfig.json --respawn --transpile-only server/src/server.ts",
    "dev:client": "vite --config client/vite.config.ts client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts client",
    "build": "npm run build:server && npm run build:client",
    "start": "node server/dist/server.js"
  },
  "keywords": [
    "email-service",
    "brevo",
    "resend",
    "hostinger",
    "fallback",
    "pixora",
    "microservice"
  ],
  "author": "Pixora Studios",
  "license": "ISC",
  "dependencies": {
    "@getbrevo/brevo": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
