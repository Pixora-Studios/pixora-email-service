# Pixora Universal Email Service Environment Configuration
PORT=5050
NODE_ENV=development
BASE_URL=http://localhost:5050

MASTER_ADMIN_KEY=your-secret-master-admin-key

FROM_EMAIL=hello@pixorastudios.com
FROM_NAME=Pixora Studios

# Provider 1: Brevo (Primary Tier - 300 free emails/day)
BREVO_API_KEY=your-brevo-api-key

# Provider 2: Resend (Secondary Tier - 100 free emails/day)
RESEND_API_KEY=your-resend-api-key

# Provider 3: Hostinger / Titan Mail SMTP (Fallback Tier)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_SECURE=true
HOSTINGER_SMTP_USER=hello@pixorastudios.com
HOSTINGER_SMTP_PASS=your-smtp-password

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ALLOWED_ORIGINS=*
